l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.538-.196 1.006.128.832.923z\"/>\n              </svg>\n            </a>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer-bottom-bar\">\n        <p class=\"footer-copyright\">&copy; 2026 kayachatagency.com. All rights reserved.</p>\n        <button type=\"button\" class=\"back-to-top-btn\" id=\"backToTopBtn\" aria-label=\"Back to Top\">\n          <span>Back to Top</span>\n          <svg viewBox=\"0 0 24 24\" role=\"img\" aria-hidden=\"true\">\n            <path d=\"M12 4l-8 8h5v8h6v-8h5z\"/>\n          </svg>\n        </button>\n      </div>\n    </div>\n  </footer>\n\n  <!-- ==========================================================================\n       IMAGE POPUP OVERVIEW MODAL (LIGHTBOX)\n       ========================================================================== -->\n  <div class=\"image-modal-overlay\" id=\"imageOverviewModal\" role=\"dialog\" aria-modal=\"true\" aria-hidden=\"true\">\n    <div class=\"image-modal-content-wrap\">\n      <button type=\"button\" class=\"image-modal-close-btn\" id=\"imageModalCloseBtn\" aria-label=\"Close overview popup\">&times;</button>\n      <img src=\"\" alt=\"\" id=\"imageModalPreview\" class=\"image-modal-preview\">\n      <p class=\"image-modal-caption\" id=\"imageModalCaption\"></p>\n    </div>\n  </div>\n\n  <!-- ==========================================================================\n       INTERNAL JAVASCRIPT (INLINE IN BODY)\n       ========================================================================== -->\n  <script>\n    (function () {\n      // 1. Mobile Navigation Toggle\n      var navToggleBtn = document.getElementById('navToggleBtn');\n      var mobileNavDrawer = document.getElementById('mobileNavDrawer');\n      var mobileLinks = document.querySelectorAll('.mobile-link');\n\n      if (navToggleBtn && mobileNavDrawer) {\n        navToggleBtn.addEventListener('click', function () {\n          var isOpen = mobileNavDrawer.classList.toggle('open');\n          navToggleBtn.classList.toggle('active', isOpen);\n          navToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');\n          mobileNavDrawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');\n        });\n\n        mobileLinks.forEach(function (link) {\n          link.addEventListener('click', function () {\n            mobileNavDrawer.classList.remove('open');\n            navToggleBtn.classList.remove('active');\n            navToggleBtn.setAttribute('aria-expanded', 'false');\n            mobileNavDrawer.setAttribute('aria-hidden', 'true');\n          });\n        });\n      }\n\n      // 2. Image Overview Popup Modal\n      var modalOverlay = document.getElementById('imageOverviewModal');\n      var modalPreview = document.getElementById('imageModalPreview');\n      var modalCaption = document.getElementById('imageModalCaption');\n      var modalCloseBtn = document.getElementById('imageModalCloseBtn');\n      var zoomableImages = document.querySelectorAll('.zoomable-img');\n\n      function openImageModal(img) {\n        if (!modalOverlay || !modalPreview) return;\n        modalPreview.src = img.src;\n        modalPreview.alt = img.alt || 'Overview preview';\n        if (modalCaption) {\n          modalCaption.textContent = img.alt || '';\n        }\n        modalOverlay.classList.add('active');\n        modalOverlay.setAttribute('aria-hidden', 'false');\n        document.body.style.overflow = 'hidden';\n      }\n\n      function closeImageModal() {\n        if (!modalOverlay) return;\n        modalOverlay.classList.remove('active');\n        modalOverlay.setAttribute('aria-hidden', 'true');\n        document.body.style.overflow = '';\n      }\n\n      zoomableImages.forEach(function (img) {\n        // Parent card click triggers modal\n        var parentCard = img.closest('.media-image-card');\n        if (parentCard) {\n          parentCard.addEventListener('click', function () {\n            openImageModal(img);\n          });\n        } else {\n          img.addEventListener('click', function () {\n            openImageModal(img);\n          });\n        }\n      });\n\n      if (modalCloseBtn) {\n        modalCloseBtn.addEventListener('click', function (e) {\n          e.stopPropagation();\n          closeImageModal();\n        });\n      }\n\n      if (modalOverlay) {\n        modalOverlay.addEventListener('click', function (e) {\n          if (e.target === modalOverlay) {\n            closeImageModal();\n          }\n        });\n      }\n\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Escape' && modalOverlay && modalOverlay.classList.contains('active')) {\n          closeImageModal();\n        }\n      });\n\n      // 3. FAQ Accordion Interaction\n      var faqTriggers = document.querySelectorAll('.faq-accordion-trigger');\n      faqTriggers.forEach(function (trigger) {\n        trigger.addEventListener('click', function () {\n          var item = trigger.closest('.faq-accordion-item');\n          if (!item) return;\n          var isActive = item.classList.contains('active');\n\n          // Close all items\n          document.querySelectorAll('.faq-accordion-item').forEach(function (otherItem) {\n            otherItem.classList.remove('active');\n            var otherTrigger = otherItem.querySelector('.faq-accordion-trigger');\n            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');\n          });\n\n          // Toggle current item\n          if (!isActive) {\n            item.classList.add('active');\n            trigger.setAttribute('aria-expanded', 'true');\n          }\n        });\n      });\n\n      // 4. Back To Top Button\n      var backToTopBtn = document.getElementById('backToTopBtn');\n      if (backToTopBtn) {\n        backToTopBtn.addEventListener('click', function () {\n          window.scrollTo({\n            top: 0,\n            behavior: 'smooth'\n          });\n        });\n      }\n    })();\n  </script>"
              },
