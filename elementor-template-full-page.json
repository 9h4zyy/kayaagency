            {
              "id": "widget_full",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"bg-grid-pattern\"></div>\n<header class=\"site-header\">\n    <nav class=\"navbar-capsule\" aria-label=\"Main Navigation\">\n      <a href=\"#home\" class=\"site-logo-link\" aria-label=\"Kaya Chat Home\">\n        <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/logo-kaya.webp\" alt=\"Kaya Chat Logo\" width=\"38\" height=\"38\" class=\"site-logo\">\n      </a>\n      <ul class=\"nav-menu\">\n        <li><a href=\"#home\" class=\"nav-link\">Home</a></li>\n        <li><a href=\"#agent-vs-host\" class=\"nav-link\">Host</a></li>\n        <li><a href=\"#agency-registration\" class=\"nav-link\">Agent</a></li>\n        <li><a href=\"#tutorial\" class=\"nav-link\">Withdraw</a></li>\n        <li><a href=\"#footer\" class=\"nav-link\">Contact</a></li>\n      </ul>\n      <button type=\"button\" class=\"nav-toggle-btn\" id=\"navToggleBtn\" aria-label=\"Toggle navigation menu\" aria-expanded=\"false\">\n        <span></span>\n        <span></span>\n        <span></span>\n      </button>\n    </nav>\n    <div class=\"mobile-nav-drawer\" id=\"mobileNavDrawer\" aria-hidden=\"true\">\n      <a href=\"#home\" class=\"nav-link mobile-link\">Home</a>\n      <a href=\"#agent-vs-host\" class=\"nav-link mobile-link\">Host</a>\n      <a href=\"#agency-registration\" class=\"nav-link mobile-link\">Agent</a>\n      <a href=\"#tutorial\" class=\"nav-link mobile-link\">Withdraw</a>\n      <a href=\"#footer\" class=\"nav-link mobile-link\">Contact</a>\n    </div>\n  </header>\n\n  <main>\n    <!-- ==========================================================================\n         HERO SECTION\n         ========================================================================== -->\n    <section class=\"section section-hero\">\n      <div class=\"hero-glow-element\" aria-hidden=\"true\"></div>\n      <div class=\"container\">\n        <div class=\"hero-grid\">\n          <div class=\"hero-text-col\">\n            <h1 class=\"hero-title\">Find Your Voice or Build Your Team All on Kaya Chat.</h1>\n            <p class=\"hero-description\">Kaya Chat brings people together through live voice rooms. Meet new people, join conversations, share gifts, and host a room of your own. Looking for an active role? Become a host or build your own team as a Kaya Chat agent.</p>\n            <div class=\"hero-cta-group\">\n              <a href=\"#agent-vs-host\" class=\"btn btn-secondary\">More About Host</a>\n              <a href=\"#what-is-kaya-agency\" class=\"btn btn-primary\">More About Agent</a>\n            </div>\n            <div class=\"hero-telegram-wrap\" style=\"margin-top: 1rem;\">\n              <a href=\"https://t.me/KayaChatService_bot\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn btn-secondary btn-telegram\" id=\"hero-cta-telegram\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\" style=\"margin-right: 8px; flex-shrink: 0; color: #38bdf8;\">\n                  <path d=\"M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18.945-.968 4.603-1.36 6.705-.166.89-.496 1.188-.813 1.217-.69.063-1.214-.455-1.884-.894-1.048-.687-1.64-1.114-2.658-1.784-1.176-.775-.413-1.201.257-1.897.175-.182 3.21-2.942 3.27-3.195.008-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.329-.913.489-1.302.481-.428-.009-1.252-.242-1.865-.441-.751-.244-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635.099-.002.321.023.465.14.121.098.155.232.166.326.012.099.027.34-.002.502z\"/>\n                </svg>\n                <span>Get Help on Telegram</span>\n              </a>\n            </div>\n          </div>\n          <div class=\"hero-image-col\">\n            <div class=\"hero-showcase-wrapper\">\n              <!-- Decorative Floating Ornaments -->\n              <svg class=\"ornament-floating ornament-sparkle ornament-sparkle-1\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n              </svg>\n              <svg class=\"ornament-floating ornament-sparkle ornament-sparkle-2\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n              </svg>\n              <svg class=\"ornament-floating ornament-sparkle ornament-sparkle-3\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n              </svg>\n              <div class=\"ornament-floating ornament-ring\" aria-hidden=\"true\"></div>\n\n              <div class=\"hero-showcase-card\">\n                <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/Neon-Social-Live-App-Showcase.png\" alt=\"Neon Social Live App Showcase\" width=\"1280\" height=\"1229\" class=\"zoomable-img hero-showcase-img\">\n                <span class=\"image-zoom-badge\">Click to enlarge</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         TRUST SECTION\n         ========================================================================== -->\n    <section class=\"section-trust\">\n      <div class=\"container\">\n        <div class=\"trust-card-wrapper\">\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"trust-title\">A Growing Online Community</h2>\n          <div class=\"trust-stats-grid\">\n            <div class=\"trust-stat-item\">\n              <svg class=\"trust-stat-watermark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z\"/>\n              </svg>\n              <span class=\"trust-stat-number\">500K+</span>\n              <span class=\"trust-stat-label\">Downloads</span>\n            </div>\n            <div class=\"trust-stat-item\">\n              <svg class=\"trust-stat-watermark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"/>\n              </svg>\n              <span class=\"trust-stat-number\">2K+</span>\n              <span class=\"trust-stat-label\">Reviews</span>\n            </div>\n            <div class=\"trust-stat-item\">\n              <svg class=\"trust-stat-watermark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n              </svg>\n              <span class=\"trust-stat-number\">100+</span>\n              <span class=\"trust-stat-label\">Countries</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         WHAT IS KAYA CHAT SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"what-is-kaya-chat\">\n      <div class=\"container\">\n        <div class=\"media-content-grid\">\n          <div class=\"media-text-col\">\n            <h2 class=\"section-title\">Kaya Chat is a Place to Connect &amp; Earn</h2>\n            <p class=\"content-paragraph\">Kaya Chat is a live voice party app where conversations happen in real time. Join a voice room and meet people from around the world.</p>\n            <p class=\"content-paragraph\">You can also become a Host or Agent to take an active role in the community by hosting your own room or building a team of hosts.</p>\n          </div>\n          <div class=\"media-image-col\">\n            <div class=\"media-image-wrapper\">\n              <div class=\"ornament-blob-glow\" aria-hidden=\"true\"></div>\n              <div class=\"ornament-floating ornament-ring-cyan\" aria-hidden=\"true\"></div>\n              <svg class=\"ornament-floating ornament-sparkle ornament-sparkle-1\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n              </svg>\n              <div class=\"media-image-card\">\n                <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/Kaya-Ecosystem.png\" alt=\"Kaya - Ecosystem\" width=\"1350\" height=\"860\" loading=\"lazy\" class=\"zoomable-img\">\n                <span class=\"image-zoom-badge\">Click to enlarge</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         WHAT IS KAYA AGENCY SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"what-is-kaya-agency\">\n      <div class=\"container\">\n        <div class=\"media-content-grid reverse-desktop\">\n          <div class=\"media-text-col\">\n            <h2 class=\"section-title\">Build a Team. Support Hosts. Grow Your Agency.</h2>\n            <p class=\"content-paragraph\">A Kaya Chat agency is a team of hosts managed and supported by an agent. Below is what an agent does.</p>\n            <div class=\"feature-list\">\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">1</span>\n                <span class=\"feature-text\">Recruit new hosts and help them join your agency.</span>\n              </div>\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">2</span>\n                <span class=\"feature-text\">Support hosts with their daily activities and tasks.</span>\n              </div>\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">3</span>\n                <span class=\"feature-text\">Invite sub-agents to grow your agency network.</span>\n              </div>\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">4</span>\n                <span class=\"feature-text\">Guide hosts in creating quality content.</span>\n              </div>\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">5</span>\n                <span class=\"feature-text\">Help your team understand and follow Kaya Chat's rules.</span>\n              </div>\n              <div class=\"feature-list-item\">\n                <span class=\"feature-number-badge\">6</span>\n                <span class=\"feature-text\">Monitor team activity and eligible commission opportunities.</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"media-image-col\">\n            <div class=\"media-image-wrapper\">\n              <div class=\"ornament-blob-glow\" aria-hidden=\"true\"></div>\n              <div class=\"ornament-floating ornament-ring-pink\" aria-hidden=\"true\"></div>\n              <svg class=\"ornament-floating ornament-sparkle ornament-sparkle-2\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n              </svg>\n              <div class=\"media-image-card\">\n                <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/Kaya-Agent-Role.png\" alt=\"Kaya - Agent Role\" width=\"1350\" height=\"860\" loading=\"lazy\" class=\"zoomable-img\">\n                <span class=\"image-zoom-badge\">Click to enlarge</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         AGENCY REGISTRATION SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"agency-registration\">\n      <div class=\"container\">\n        <div class=\"section-header\">\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"section-title\">Ready to Become a Kaya Chat Agent?</h2>\n          <p class=\"section-description\">Getting started is straightforward. Create your Kaya Chat account, get your Kaya ID, and complete the official agent application process.</p>\n        </div>\n        <!-- Wide Panoramic Agency Registration Infographic Showcase -->\n        <div class=\"registration-image-showcase\">\n          <div class=\"media-image-card registration-image-card\">\n            <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/Kaya-Agent-Registration.png\" alt=\"Kaya - Agency Registration\" width=\"1600\" height=\"1370\" loading=\"lazy\" class=\"zoomable-img\">\n            <span class=\"image-zoom-badge\">Click to enlarge</span>\n          </div>\n        </div>\n\n        <!-- Balanced Steps Grid -->\n        <div class=\"registration-steps-grid\">\n          <!-- Step 1 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">1</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 1. Download Kaya Chat</h3>\n              <p class=\"registration-step-desc\">Download Kaya Chat from our official <a href=\"https://h5.kayachat.live/invateshare?parent_id=10244362\" target=\"_blank\" rel=\"noopener noreferrer\">download link</a> and install it</p>\n            </div>\n          </div>\n          <!-- Step 2 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">2</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 2. Create Your Account</h3>\n              <p class=\"registration-step-desc\">Sign up using your Google account or phone number. Google registration is recommended.</p>\n            </div>\n          </div>\n          <!-- Step 3 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">3</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 3. Complete Your Profile</h3>\n              <p class=\"registration-step-desc\">Fill in the required information and make sure your account details are correct.</p>\n            </div>\n          </div>\n          <!-- Step 4 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">4</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 4. Copy Your Kaya ID</h3>\n              <p class=\"registration-step-desc\">Open your Profile or Me page and copy your Kaya ID. You will need it for the application.</p>\n            </div>\n          </div>\n          <!-- Step 5 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">5</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 5. Open the Agent Application Page</h3>\n              <p class=\"registration-step-desc\">Visit the official Kaya Chat <a href=\"https://h5.kayachat.live/applyinvatefamily?user_id=10244362&amp;language=en\" target=\"_blank\" rel=\"noopener noreferrer\">agent application page</a>. Enter your agency information and tap Get to request your verification code.</p>\n            </div>\n          </div>\n          <!-- Step 6 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">6</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 6. Retrieve Your Verification Code</h3>\n              <ul class=\"stepper-sublist\">\n                <li>1. Open the message menu.</li>\n                <li>2. Select System Notification.</li>\n                <li>3. Find the verification message.</li>\n              </ul>\n            </div>\n          </div>\n          <!-- Step 7 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">7</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 7. Submit Your Application</h3>\n              <p class=\"registration-step-desc\">Return to the agent application page. Paste your verification code and tap Submit.</p>\n            </div>\n          </div>\n          <!-- Step 8 -->\n          <div class=\"registration-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">8</span>\n            <div class=\"registration-step-content\">\n              <h3 class=\"registration-step-title\">Step 8. Check Your Agency Information</h3>\n              <p class=\"registration-step-desc\">Open your Profile page and select Agency Management to view your agency information.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         AGENT VS HOST COMPARISON SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"agent-vs-host\">\n      <div class=\"container\">\n        <div class=\"section-header\">\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"section-title\">Kaya Chat Agent vs Host</h2>\n        </div>\n\n        <!-- Mobile & Tablet Cards View -->\n        <div class=\"comparison-container\">\n          <div class=\"comparison-card\">\n            <span class=\"comparison-badge\">User Role</span>\n            <h3 class=\"comparison-card-title\"><span class=\"role-icon-inline\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20H9c-.55 0-1 .45-1 1s.45 1 1 1h6c.55 0 1-.45 1-1s-.45-1-1-1h-2v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z\"/></svg></span>Kaya Chat Host</h3>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Main Role</div>\n              <p class=\"comparison-item-text\">Create voice rooms and facilitate engaging conversations with other participants.</p>\n            </div>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Income Opportunities</div>\n              <p class=\"comparison-item-text\">Earn through chatting activity rewards, the 7-Day Income Task, virtual gifts, referral incentives, and leaderboard bonuses.</p>\n            </div>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Ideal for</div>\n              <p class=\"comparison-item-text\">Individuals who enjoy interacting with others, joining live voice sessions</p>\n            </div>\n          </div>\n\n          <div class=\"comparison-card card-agent\">\n            <span class=\"comparison-badge\">Leadership Role</span>\n            <h3 class=\"comparison-card-title\"><span class=\"role-icon-inline\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z\"/></svg></span>Kaya Chat Agent</h3>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Main Role</div>\n              <p class=\"comparison-item-text\">Recruit, coordinate, and manage a team of hosts and sub-agents.</p>\n            </div>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Income Opportunities</div>\n              <p class=\"comparison-item-text\">Generate income through agency commissions, game-related rewards, referral incentives, and agency bonuses</p>\n            </div>\n            <div class=\"comparison-item\">\n              <div class=\"comparison-item-label\">Ideal for</div>\n              <p class=\"comparison-item-text\">Individuals interested in team management, host development, recruitment</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- Desktop Comparison Table View -->\n        <div class=\"desktop-comparison-table-wrap\">\n          <table class=\"comparison-table\">\n            <thead>\n              <tr>\n                <th scope=\"col\">Feature</th>\n                <th scope=\"col\">Kaya Chat Host</th>\n                <th scope=\"col\" class=\"col-agent\">Kaya Chat Agent</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td class=\"col-feature\">Main Role</td>\n                <td class=\"col-host\">Create voice rooms and facilitate engaging conversations with other participants.</td>\n                <td class=\"col-agent\">Recruit, coordinate, and manage a team of hosts and sub-agents.</td>\n              </tr>\n              <tr>\n                <td class=\"col-feature\">Income Opportunities</td>\n                <td class=\"col-host\">Earn through chatting activity rewards, the 7-Day Income Task, virtual gifts, referral incentives, and leaderboard bonuses.</td>\n                <td class=\"col-agent\">Generate income through agency commissions, game-related rewards, referral incentives, and agency bonuses</td>\n              </tr>\n              <tr>\n                <td class=\"col-feature\">Ideal for</td>\n                <td class=\"col-host\">Individuals who enjoy interacting with others, joining live voice sessions</td>\n                <td class=\"col-agent\">Individuals interested in team management, host development, recruitment</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         TUTORIAL (WITHDRAW) SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"tutorial\">\n      <div class=\"container\">\n        <div class=\"section-header\">\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"section-title\">Kaya Chat Agent Withdraw Tutorial</h2>\n          <p class=\"section-description\">Before you withdraw, check the minimum amount, review the available methods, and follow the steps in your Kaya Chat agent account</p>\n        </div>\n\n        <!-- Wide Panoramic Tutorial Infographic Showcase -->\n        <div class=\"tutorial-image-showcase\">\n          <div class=\"media-image-card tutorial-image-card\">\n            <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/Kaya-AgentHost-Withdraw.png\" alt=\"Kaya - AgentHost Withdraw\" width=\"1600\" height=\"685\" loading=\"lazy\" class=\"zoomable-img\">\n            <span class=\"image-zoom-badge\">Click to enlarge</span>\n          </div>\n        </div>\n\n        <!-- Balanced Steps Grid -->\n        <div class=\"tutorial-steps-grid\">\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">1</span>\n            <p class=\"tutorial-step-text\">1. Open Kaya Chat and go to your Profile page.</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">2</span>\n            <p class=\"tutorial-step-text\">2. Tap &ldquo;Diamonds.&rdquo;</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">3</span>\n            <p class=\"tutorial-step-text\">3. Tap &ldquo;Withdrawal.&rdquo;</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">4</span>\n            <p class=\"tutorial-step-text\">4. Bind your &ldquo;Pay Out Address.&rdquo;</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">5</span>\n            <p class=\"tutorial-step-text\">5. Choose a payout method from the available options.</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">6</span>\n            <p class=\"tutorial-step-text\">6. Enter the amount you want to withdraw.</p>\n          </div>\n          <div class=\"tutorial-step-card\">\n            <span class=\"step-indicator-pill\" aria-hidden=\"true\">7</span>\n            <p class=\"tutorial-step-text\">7. Follow any additional prompts shown in the app to complete the request.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         FAQS SECTION\n         ========================================================================== -->\n    <section class=\"section\" id=\"faq\">\n      <div class=\"container\">\n        <div class=\"section-header\">\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"section-title\">Frequently Asked Questions</h2>\n        </div>\n        <div class=\"faq-accordion-list\">\n          <!-- FAQ 1 (Active by default) -->\n          <div class=\"faq-accordion-item active\">\n            <button type=\"button\" class=\"faq-accordion-trigger\" aria-expanded=\"true\">\n              <span>What is Kaya Chat?</span>\n              <svg class=\"faq-icon-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"6 9 12 15 18 9\"></polyline>\n              </svg>\n            </button>\n            <div class=\"faq-accordion-panel\">\n              <p class=\"faq-answer-text\">Kaya Chat is a live voice party app that lets you join voice rooms, connect with new people, host your own room, send virtual gifts, earn coins, and move up the leaderboards.</p>\n            </div>\n          </div>\n\n          <!-- FAQ 2 -->\n          <div class=\"faq-accordion-item\">\n            <button type=\"button\" class=\"faq-accordion-trigger\" aria-expanded=\"false\">\n              <span>What is the difference between a host and an agent?</span>\n              <svg class=\"faq-icon-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"6 9 12 15 18 9\"></polyline>\n              </svg>\n            </button>\n            <div class=\"faq-accordion-panel\">\n              <p class=\"faq-answer-text\">Hosts mainly focus on participating in voice rooms and earning host-related rewards. Agents, on the other hand, recruit and support host teams, invite hosts and sub-agents, and earn eligible commissions and referral rewards.</p>\n            </div>\n          </div>\n\n          <!-- FAQ 3 -->\n          <div class=\"faq-accordion-item\">\n            <button type=\"button\" class=\"faq-accordion-trigger\" aria-expanded=\"false\">\n              <span>How do I become a host?</span>\n              <svg class=\"faq-icon-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"6 9 12 15 18 9\"></polyline>\n              </svg>\n            </button>\n            <div class=\"faq-accordion-panel\">\n              <p class=\"faq-answer-text\">Download Kaya Chat, create an account, and complete your profile. Then, go to Profile &gt; &ldquo;Become a Host,&rdquo; finish the real-person verification, tap &ldquo;Join Agency,&rdquo; and enter the invitation code provided to you.</p>\n            </div>\n          </div>\n\n          <!-- FAQ 4 -->\n          <div class=\"faq-accordion-item\">\n            <button type=\"button\" class=\"faq-accordion-trigger\" aria-expanded=\"false\">\n              <span>How do I become an agent?</span>\n              <svg class=\"faq-icon-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n                <polyline points=\"6 9 12 15 18 9\"></polyline>\n              </svg>\n            </button>\n            <div class=\"faq-accordion-panel\">\n              <p class=\"faq-answer-text\">First, create a Kaya Chat account and copy your Kaya ID. Next, visit the official agent application link and request a verification code. Copy the code from System Notification, enter it on the application page, and then check &ldquo;Agency Management&rdquo; in your profile.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ==========================================================================\n         FINAL CTA SECTION\n         ========================================================================== -->\n    <section class=\"section-final-cta\" id=\"cta\">\n      <div class=\"container\">\n        <div class=\"cta-box-wrapper\">\n          <div class=\"cta-ornament-ring\" aria-hidden=\"true\"></div>\n          <svg class=\"ornament-floating cta-ornament-star-1\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n          </svg>\n          <svg class=\"ornament-floating cta-ornament-star-2\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5Z\"/>\n          </svg>\n          <div class=\"section-ornament-divider\" aria-hidden=\"true\"><span class=\"divider-line\"></span><span class=\"divider-gem\"></span><span class=\"divider-line-right\"></span></div>\n          <h2 class=\"cta-title\">Ready to Join Kaya Chat Agency?</h2>\n          <p class=\"cta-description\">Take the next step toward building a host team as an agent. Download Kaya Chat, set up your account right now.</p>\n          <div class=\"cta-actions-group\">\n            <a href=\"https://h5.kayachat.live/applyinvatefamily?user_id=10244362&amp;language=en\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn btn-primary\">Become an Agent</a>\n            <a href=\"https://kayahostlive.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn btn-secondary\">Learn More as Host</a>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <!-- ==========================================================================\n       FOOTER\n       ========================================================================== -->\n  <footer class=\"site-footer\" id=\"footer\">\n    <div class=\"container\">\n      <div class=\"footer-grid\">\n        <div class=\"footer-col-logo\">\n          <a href=\"#home\" class=\"site-logo-link\" aria-label=\"Kaya Chat Home\">\n            <img src=\"http://kayachatagency.com/wp-content/uploads/2026/11/logo-kaya.webp\" alt=\"Kaya Chat Logo\" width=\"42\" height=\"42\" loading=\"lazy\" class=\"footer-logo\">\n          </a>\n        </div>\n        <div>\n          <h3 class=\"footer-col-title\">Quick Links</h3>\n          <ul class=\"footer-nav-list\">\n            <li><a href=\"#home\" class=\"footer-nav-link\">Home</a></li>\n            <li><a href=\"#agent-vs-host\" class=\"footer-nav-link\">Host</a></li>\n            <li><a href=\"#agency-registration\" class=\"footer-nav-link\">Agent</a></li>\n            <li><a href=\"#tutorial\" class=\"footer-nav-link\">Withdraw</a></li>\n            <li><a href=\"#faq\" class=\"footer-nav-link\">FAQ</a></li>\n          </ul>\n        </div>\n        <div>\n          <h3 class=\"footer-col-title\">Contact &amp; Support</h3>\n          <div class=\"footer-social-list\">\n            <a href=\"https://www.instagram.com/kayalivechat\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-icon-btn\" aria-label=\"Instagram\">\n              <svg viewBox=\"0 0 24 24\" role=\"img\" aria-hidden=\"true\">\n                <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-